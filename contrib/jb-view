#!/bin/sh
# jb-view — sidecar session formatter for jb
# Reads .jb/sessions/<uuid>/session.jsonl (pi format v3) and formats the
# conversation as a readable log. Phase 9 restores the rich tool-call view.

# ---- ANSI ----
R='\033[0m'
B='\033[1m'
D='\033[2m'
GRN='\033[32m'
YEL='\033[33m'
CYN='\033[36m'

# ---- Dependency check ----
if ! command -v jq >/dev/null 2>&1; then
    echo "jb-view: jq is required but not found in PATH" >&2
    exit 1
fi

# ---- Session discovery: resolve the repo by walking up from cwd ----
dir=$(pwd)
SESSIONS_DIR=""
while [ -n "$dir" ]; do
    if [ -d "$dir/.jb/sessions" ]; then
        SESSIONS_DIR="$dir/.jb/sessions"
        break
    fi
    dir=${dir%/*}
done

if [ -z "$SESSIONS_DIR" ]; then
    echo "jb-view: not a jb repository (run 'jb init')" >&2
    exit 1
fi

if [ -n "$1" ]; then
    SESSION_UUID="$1"
else
    SESSION_UUID=$(ls -1t "$SESSIONS_DIR" 2>/dev/null | head -1)
fi

if [ -z "$SESSION_UUID" ]; then
    echo "jb-view: no sessions found in $SESSIONS_DIR" >&2
    exit 1
fi

STATE_FILE="$SESSIONS_DIR/$SESSION_UUID/session.jsonl"
META_FILE="$SESSIONS_DIR/$SESSION_UUID/metadata.json"

if [ ! -f "$STATE_FILE" ]; then
    echo "jb-view: session file not found: $STATE_FILE" >&2
    exit 1
fi

# ---- Session header (from metadata) ----
if [ -f "$META_FILE" ]; then
    _uuid=$(jq -r '.uuid // empty' "$META_FILE" 2>/dev/null)
    _status=$(jq -r '.status // empty' "$META_FILE" 2>/dev/null)
    _model=$(jq -r '.config.model // empty' "$META_FILE" 2>/dev/null)
    _turns=$(jq -r '.turns // empty' "$META_FILE" 2>/dev/null)
    _subject=$(jq -r '.subject // empty' "$META_FILE" 2>/dev/null)

    _short_uuid=$(printf '%s' "$_uuid" | cut -c1-8)

    _header_parts="$_short_uuid"
    [ -n "$_status" ] && _header_parts="$_header_parts  $_status"
    [ -n "$_model" ] && _header_parts="$_header_parts  $_model"
    [ -n "$_turns" ] && [ "$_turns" != "null" ] && _header_parts="$_header_parts  ${_turns} turns"

    printf "${D}session %s${R}\n" "$_header_parts"
    [ -n "$_subject" ] && printf "${D}> %s${R}\n\n" "$_subject"
fi

# ---- Truncation ----
MAX_LINES=6

render_text() {
    _n=0
    printf '%s\n' "$1" | while IFS= read -r _line || [ -n "$_line" ]; do
        _n=$((_n + 1))
        if [ "$_n" -gt "$MAX_LINES" ]; then printf "${D}...${R}\n"; break; fi
        printf "${D}%s${R}\n" "$_line"
    done
}

# ---- Render pi-format entries ----
jq -r '
  select(.type == "message") |
  .message |
  if .role == "user" then
    "USER: " + (.content | map(select(.type == "text") | .text) | join(""))
  elif .role == "assistant" then
    "ASSISTANT: " + (.content | map(select(.type == "text") | .text) | join(""))
  elif .role == "toolResult" then
    "TOOL " + (.toolName // "") + ": " + (.content | map(select(.type == "text") | .text) | join(""))
  else empty end
' "$STATE_FILE" | while IFS= read -r _line || [ -n "$_line" ]; do
    case "$_line" in
        USER:*)      printf "${CYN}${B}%s${R}\n" "$_line" ;;
        ASSISTANT:*) printf "%s\n" "$_line" ;;
        TOOL*)       printf "${YEL}${B}%s${R}\n" "$_line" ;;
        *)           printf "%s\n" "$_line" ;;
    esac
done
